<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/row_active" />
            <stroke android:width="1.5dp" android:color="@color/fab_stroke" />
            <corners android:radius="99dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/fab_bg" />
            <stroke android:width="1.5dp" android:color="@color/fab_stroke" />
            <corners android:radius="99dp" />
        </shape>
    </item>
</selector>
