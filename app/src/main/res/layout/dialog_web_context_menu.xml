<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_surface"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="18dp">

    <!-- 顶部精致拖动手柄条 -->
    <View
        android:id="@+id/sheetHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:alpha="0.65"
        android:background="@drawable/bg_sheet_handle" />

    <!-- 目标信息预览条（类型标签 + 精简地址） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/sheetBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_btn_muted"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:textColor="@color/blue"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheetSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 操作项圆角卡片容器 -->
    <LinearLayout
        android:id="@+id/sheetActionsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <!-- 独立圆角取消按钮 -->
    <TextView
        android:id="@+id/sheetCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:text="@string/btn_cancel"
        android:textColor="@color/text_muted"
        android:textSize="14.5sp"
        android:textStyle="bold" />
</LinearLayout>
