<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg">

        <!-- ======= 内容区：左侧窄条 + 主区 ======= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- 左侧窄条（收起态账号列表） -->
            <LinearLayout
                android:id="@+id/rail"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:background="@color/rail_bg"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal">

                    <ImageButton
                        android:id="@+id/btnRailExpand"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_rail_btn"
                        android:contentDescription="@string/cd_expand"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/icon_primary" />

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="9dp"
                        android:layout_marginEnd="9dp"
                        android:background="@drawable/bg_notify" />
                </FrameLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/railAvatars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />
                </ScrollView>

                <!-- 日夜模式切换 -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal">

                    <ImageButton
                        android:id="@+id/btnThemeToggle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_rail_btn"
                        android:contentDescription="@string/cd_theme_to_light"
                        android:src="@drawable/ic_sun"
                        app:tint="@color/icon_primary" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal">

                    <ImageButton
                        android:id="@+id/btnFullscreen"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_rail_btn"
                        android:contentDescription="@string/cd_fullscreen"
                        android:src="@drawable/ic_fullscreen"
                        app:tint="@color/icon_primary" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal">

                    <ImageButton
                        android:id="@+id/btnRailAdd"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_rail_add"
                        android:contentDescription="@string/cd_add"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/blue" />
                </FrameLayout>
            </LinearLayout>

            <!-- 主区：Muse 网页 -->
            <FrameLayout
                android:id="@+id/mainContentArea"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/chat_bg">

                <!-- 账号 WebView 容器：每个账号一个独立 WebView，切换时换显示 -->
                <FrameLayout
                    android:id="@+id/webContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/chat_bg" />

                <!-- 空状态 -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/chat_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="30dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/emptyTile"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_mtile"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="m"
                        android:textColor="@color/m_blue"
                        android:textSize="33sp"
                        android:textStyle="bold|italic"
                        android:alpha="0.5" />

                    <TextView
                        android:id="@+id/emptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/empty_title"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/emptySub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/empty_sub"
                        android:textColor="@color/text_muted"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/btnEmptyAdd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_blue_btn"
                        android:paddingLeft="30dp"
                        android:paddingRight="30dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/empty_add"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 加载失败遮罩：主框架加载错误时显示，可一键重试 -->
                <LinearLayout
                    android:id="@+id/errorOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/chat_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="30dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/errorTile"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_mtile"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="!"
                        android:textColor="@color/del_btn_bg"
                        android:textSize="33sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/errorTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/error_title"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/errorMsg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textColor="@color/text_muted"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/errorHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/error_hint"
                        android:textColor="@color/text_muted"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/btnRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_blue_btn"
                        android:paddingLeft="34dp"
                        android:paddingRight="34dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/error_retry"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 顶部极细渐变页面加载进度条（仅加载中显示，完成后平滑淡出） -->
                <ProgressBar
                    android:id="@+id/webLoadProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:layout_gravity="top"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_page_progress"
                    android:visibility="gone" />

                <!-- 下载悬浮状态卡：支持实时进度/取消，完成后平滑切换为保存位置与一键查看 -->
                <LinearLayout
                    android:id="@+id/downloadBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_download_banner"
                    android:clickable="true"
                    android:elevation="8dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/downloadBadge"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_download_badge_active">

                        <ImageView
                            android:id="@+id/downloadBadgeIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_download"
                            app:tint="@color/blue" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textDownloadTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/fab_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textDownloadSaved"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1.5dp"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:textColor="@color/text_muted"
                            android:textSize="11.5sp" />

                        <ProgressBar
                            android:id="@+id/downloadProgressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="3.5dp"
                            android:layout_marginTop="6dp"
                            android:indeterminateTint="@color/blue"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/bg_download_progress"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnOpenDownload"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_pill_btn_primary"
                        android:paddingStart="13dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="13dp"
                        android:paddingBottom="6dp"
                        android:text="@string/btn_open_download"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 外部网页悬浮返回按钮：位于 WebView 和错误遮罩之上，支持拖动与一键回到 Muse -->
                <LinearLayout
                    android:id="@+id/btnBackToMuse"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_fab_muse"
                    android:clickable="true"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingEnd="15dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/iconBackToMuse"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_return_muse"
                        app:tint="@color/blue" />

                    <TextView
                        android:id="@+id/textBackToMuse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/btn_back_to_muse"
                        android:textColor="@color/fab_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 切换环境过渡层 -->
                <FrameLayout
                    android:id="@+id/splash"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/splash_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/splashTile"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_mtile"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="m"
                            android:textColor="@color/m_blue"
                            android:textSize="27sp"
                            android:textStyle="bold|italic" />

                        <TextView
                            android:id="@+id/splashName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/splashSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/splash_sub"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />

                        <ProgressBar
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginTop="14dp"
                            android:indeterminateTint="@color/blue" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ======= 抽屉（展开态账号列表） ======= -->
        <LinearLayout
            android:id="@+id/drawerContent"
            android:layout_width="274dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/drawer_bg"
            android:fitsSystemWindows="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/drawerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/drawer_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/accCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/text_muted"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnDrawerThemeToggle"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_rail_btn"
                    android:contentDescription="@string/cd_theme_to_light"
                    android:src="@drawable/ic_sun"
                    app:tint="@color/icon_primary" />

                <ImageButton
                    android:id="@+id/btnCollapse"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_rail_btn"
                    android:contentDescription="@string/cd_collapse"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/icon_primary" />
            </LinearLayout>

            <!-- 搜索框：按名称 + 标签过滤 -->
            <FrameLayout
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search">

                <ImageView
                    android:id="@+id/searchIcon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/icon_search" />

                <EditText
                    android:id="@+id/drawerSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="11dp"
                    android:paddingStart="40dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_dim"
                    android:textSize="13.5sp" />
            </FrameLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/accountList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp" />
            </ScrollView>

            <TextView
                android:id="@+id/drawerEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="18dp"
                android:text="@string/search_empty"
                android:textColor="@color/text_muted"
                android:textSize="12.5sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/btnAddAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_addcard"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <FrameLayout
                    android:id="@+id/addPlusWrap"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_addplus">

                    <ImageView
                        android:id="@+id/addPlusIcon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_add"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/blue" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/addAccountTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_account"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/addAccountSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/add_account_sub"
                        android:textColor="@color/text_muted"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 全局下载目录配置：未配置时自动保存到默认目录（相册 / Download/Muse） -->
            <LinearLayout
                android:id="@+id/downloadDirCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/downloadDirTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/drawer_download_dir_title"
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/downloadDirPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:text="@string/drawer_download_dir_default"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnResetDownloadDir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_editbtn"
                    android:paddingLeft="9dp"
                    android:paddingRight="9dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="@string/drawer_download_dir_reset"
                    android:textColor="@color/btn_gray_text"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnPickDownloadDir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_editbtn"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="@string/drawer_download_dir_pick"
                    android:textColor="@color/btn_gray_text"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 应用版本与在线检查更新卡片 -->
            <LinearLayout
                android:id="@+id/updateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/updateCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/drawer_update_title"
                            android:textColor="@color/text_primary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/updateBadgeDot"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_update_dot"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/updateVersionSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_editbtn"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="@string/drawer_update_check"
                    android:textColor="@color/btn_gray_text"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/shieldIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/icon_search" />

                <TextView
                    android:id="@+id/drawerFootnote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/drawer_footnote"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.drawerlayout.widget.DrawerLayout>

    <!-- 全屏模式下：左缘手势条（置于顶层，向内划动唤回侧栏） -->
    <View
        android:id="@+id/edgeSwipe"
        android:layout_width="16dp"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 网页视频真全屏容器（WebChromeClient.onShowCustomView 挂载点） -->
    <FrameLayout
        android:id="@+id/fullscreenVideoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />
</FrameLayout>
