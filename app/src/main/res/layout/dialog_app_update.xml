<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_update_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 顶部品牌徽章 + 标题与版本胶囊 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/updateDialogTile"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_mtile"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="m"
            android:textColor="@color/m_blue"
            android:textSize="22sp"
            android:textStyle="bold|italic" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/updateDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_dialog_title"
                android:textColor="@color/text_primary"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updateDialogVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_btn_muted"
                android:paddingStart="9dp"
                android:paddingTop="2.5dp"
                android:paddingEnd="9dp"
                android:paddingBottom="2.5dp"
                android:textColor="@color/blue"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 更新说明卡片（可滚动，上限 210dp） -->
    <ScrollView
        android:id="@+id/updateDialogNotesScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:fadeScrollbars="false"
        android:overScrollMode="ifContentScrolls">

        <TextView
            android:id="@+id/updateDialogNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.42"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </ScrollView>

    <!-- 主操作按钮：立即更新 -->
    <TextView
        android:id="@+id/btnUpdateNow"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_pill_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/update_btn_now"
        android:textColor="#FFFFFFFF"
        android:textSize="14.5sp"
        android:textStyle="bold" />

    <!-- 次要操作行：稍后 / 忽略此版 / 浏览器下载 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnUpdateLater"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/update_btn_later"
            android:textColor="@color/text_muted"
            android:textSize="12.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="·"
            android:textColor="@color/dot_off"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnUpdateSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/update_btn_skip"
            android:textColor="@color/text_muted"
            android:textSize="12.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="·"
            android:textColor="@color/dot_off"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnUpdateBrowser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/update_btn_browser"
            android:textColor="@color/blue"
            android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
